{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "ENS verifiable factory contract fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/ensdomains-verifiable-factory",
  "commit": "cd6622442c298ae89c4d92bcbc93a0faca4fbfae",
  "packageManager": "pnpm",
  "submodules": true,
  "env": {
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 13,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 77,
        "command": "forge build"
      },
      "forge test": {
        "runs": 69,
        "command": "forge test"
      }
    }
  }
}
