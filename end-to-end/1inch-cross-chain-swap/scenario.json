{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "1inch Network Fusion Atomic Swaps fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "Wodann/cross-chain-swap",
  "commit": "690f7f6bbc826ab3d58995e4bc5bf01694222086",
  "packageManager": "yarn",
  "submodules": true,
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "env": {
    "FOUNDRY_PROFILE": "default",
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 3,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 97,
        "command": "forge build"
      },
      "forge test": {
        "runs": 9,
        "command": "forge test"
      }
    }
  }
}
