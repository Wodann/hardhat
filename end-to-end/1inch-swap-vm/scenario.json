{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "1inch SwapVM contract fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/1inch-swap-vm",
  "commit": "eacd08361caf75431d2b4409136cf4eb10fa63a3",
  "packageManager": "pnpm",
  "submodules": false,
  "env": {
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 3,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 45,
        "command": "forge build"
      },
      "forge test": {
        "runs": 29,
        "command": "forge test"
      }
    }
  }
}
