{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Lido Dual Governance Smart contracts fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "popescuoctavian/dual-governance",
  "commit": "ef72db01b9b69fddc7fefae9da160e465921ec42",
  "packageManager": "npm",
  "submodules": true,
  "env": {
    "MAINNET_RPC_URL": "${localEnv:ALCHEMY_URL}",
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity --grep=\"^(test_|testFuzz_)\"",
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 3,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 83,
        "command": "forge build"
      },
      "forge test": {
        "runs": 3,
        "command": "forge test --match-test \"^(test_|testFuzz_)\""
      }
    }
  }
}
