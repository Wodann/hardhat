{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "OpenZeppelin's Hardhat 3 migration branch (PR #6542) including their Mocha test suite.",
  "tags": ["external-repo", "mocha"],
  "repo": "OpenZeppelin/openzeppelin-contracts",
  "commit": "b12a51e14e0dd8232d4a8d6756a70e90a7387fea",
  "packageManager": "npm",
  "submodules": true,
  "preinstall": "./preinstall.sh",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=8192"
  },
  "defaultCommand": "npx hardhat test mocha",
  "benchmark": {
    "commands": {
      "compile sequence": {
        "runs": 3,
        "steps": {
          "reset files & cache": {
            "command": "git checkout -- contracts/utils/math/Math.sol && npx hardhat clean",
            "measure": false
          },
          "cold compile": {
            "command": "npx hardhat compile --no-tests",
            "dependsOn": ["reset files & cache"]
          },
          "edit & compile Solidity contract: contracts/utils/math/Math.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> contracts/utils/math/Math.sol && npx hardhat compile --no-tests",
            "dependsOn": ["cold compile"]
          }
        }
      },
      "warm compile": {
        "runs": 10,
        "command": "npx hardhat compile --no-tests",
        "dependsOn": ["cold compile"]
      },
      "test mocha": {
        "runs": 5,
        "command": "timeout -k 15 200 npx hardhat test mocha --no-compile || true",
        "dependsOn": ["cold compile"]
      }
    }
  }
}
