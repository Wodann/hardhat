{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Uniswap V4 core contracts fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/uniswap-v4-core",
  "commit": "ab2b22eef19e0abe29d67420dde81b5d54455ae5",
  "packageManager": "pnpm",
  "submodules": true,
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 3,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 51,
        "command": "forge build"
      },
      "forge test": {
        "runs": 7,
        "command": "forge test"
      }
    }
  }
}
