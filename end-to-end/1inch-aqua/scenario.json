{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "1inch Aqua Protocol fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/aqua",
  "commit": "19277969b5e67b5b55968422b4cba4029544807c",
  "packageManager": "yarn",
  "submodules": false,
  "env": {
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "forge build (cold)": {
        "runs": 5,
        "prepare": "forge clean",
        "command": "forge build"
      },
      "forge build (warm)": {
        "runs": 55,
        "command": "forge build"
      },
      "forge test": {
        "runs": 83,
        "command": "forge test"
      }
    }
  }
}
